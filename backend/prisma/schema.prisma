generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_MClSTy2rtm7q@ep-noisy-cell-apql0ish.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
}

model User {
  id            String         @id @default(uuid())
  phone         String         @unique
  name          String?
  city          String?
  bookerScore   Float          @default(5.0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings      Booking[]
  chatMessages  ChatMessage[]
  favourites    Favourite[]
  notifications Notification[]
  reviews       Review[]
}

model Worker {
  id              String          @id @default(uuid())
  phone           String          @unique
  name            String?
  city            String?
  profilePhoto    String?
  homeLat         Float?
  homeLng         Float?
  serviceRadius   Int             @default(10)
  aadhaarFront    String?
  aadhaarBack     String?
  aadhaarSelfie   String?
  aadhaarVerified Boolean         @default(false)
  policeVerified  Boolean         @default(false)
  status          WorkerStatus    @default(provisional)
  avgRating       Float           @default(0.0)
  totalJobs       Int             @default(0)
  completionRate  Float           @default(100.0)
  isAvailable     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  bookings        Booking[]
  chatMessages    ChatMessage[]
  favouritedBy    Favourite[]
  notifications   Notification[]
  reviews         Review[]
  earnings        WorkerEarning[]
  skills          WorkerSkill[]
}

model Admin {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String
  createdAt DateTime @default(now())
}

model ServiceCategory {
  id         String            @id @default(uuid())
  parentId   String?
  name       String
  fixedPrice Float?
  iconUrl    String?
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  bookings   Booking[]
  parent     ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   ServiceCategory[] @relation("CategoryTree")
  skills     WorkerSkill[]
}

model WorkerSkill {
  id         String          @id @default(uuid())
  workerId   String
  categoryId String
  badge      SkillBadge
  testScore  Int?
  verifiedAt DateTime        @default(now())
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  worker     Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, categoryId])
}

model Booking {
  id               String             @id @default(uuid())
  userId           String
  workerId         String?
  categoryId       String
  status           BookingStatus      @default(pending)
  address          String
  lat              Float?
  lng              Float?
  problemDesc      String?
  problemPhoto     String?
  proofPhoto       String?
  otpCode          String?
  otpVerified      Boolean            @default(false)
  basePrice        Float
  finalPrice       Float?
  isInspection     Boolean            @default(false)
  inspectionFee    Float?
  scheduledAt      DateTime?
  acceptedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  adjustmentPrice  Float?
  adjustmentReason String?
  category         ServiceCategory    @relation(fields: [categoryId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  worker           Worker?            @relation(fields: [workerId], references: [id])
  chatMessages     ChatMessage[]
  dispute          Dispute?
  escrow           EscrowTransaction?
  notifications    Notification[]
  review           Review?
  earning          WorkerEarning?

  @@index([userId])
  @@index([workerId])
  @@index([status])
}

model ChatMessage {
  id         String     @id @default(uuid())
  bookingId  String
  senderRole SenderRole
  userId     String?
  workerId   String?
  message    String
  isRead     Boolean    @default(false)
  sentAt     DateTime   @default(now())
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
  worker     Worker?    @relation(fields: [workerId], references: [id])

  @@index([bookingId])
}

model EscrowTransaction {
  id                String       @id @default(uuid())
  bookingId         String       @unique
  razorpayOrderId   String       @unique
  razorpayPaymentId String?      @unique
  amount            Float
  status            EscrowStatus @default(held)
  workerAmount      Float?
  userRefund        Float?
  releasedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  booking           Booking      @relation(fields: [bookingId], references: [id])
}

model Dispute {
  id             String         @id @default(uuid())
  bookingId      String         @unique
  reason         String
  userEvidence   String[]
  workerResponse String?
  workerEvidence String[]
  adminNote      String?
  outcome        DisputeOutcome @default(pending)
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  booking        Booking        @relation(fields: [bookingId], references: [id])
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  userId      String
  workerId    String
  rating      Int
  punctuality Int?
  quality     Int?
  behaviour   Int?
  value       Int?
  comment     String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking  @relation(fields: [bookingId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  worker      Worker   @relation(fields: [workerId], references: [id])
}

model Favourite {
  userId    String
  workerId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([userId, workerId])
}

model WorkerEarning {
  id          String    @id @default(uuid())
  workerId    String
  bookingId   String    @unique
  grossAmount Float
  commission  Float
  netAmount   Float
  upiRef      String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking   @relation(fields: [bookingId], references: [id])
  worker      Worker    @relation(fields: [workerId], references: [id])
}

model Notification {
  id            String        @id @default(uuid())
  recipientId   String
  recipientType RecipientType
  bookingId     String?
  type          String
  title         String
  body          String
  isRead        Boolean       @default(false)
  sentAt        DateTime      @default(now())
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  user          User          @relation(fields: [recipientId], references: [id], map: "Notification_recipientId_user_fkey")
  worker        Worker        @relation(fields: [recipientId], references: [id], map: "Notification_recipientId_worker_fkey")

  @@index([recipientId])
}

model ReviewTag {
  id       String  @id @default(uuid())
  label    String  @unique
  slug     String  @unique
  type     String
  isActive Boolean @default(true)
}

model OtpRequest {
  id        String   @id @default(uuid())
  phone     String
  code      String
  role      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

enum Role {
  USER
  WORKER
  ADMIN
}

enum WorkerStatus {
  provisional
  verified
  suspended
  banned
}

enum SkillBadge {
  skill_tested
  verified_by_experience
  formally_certified
}

enum BookingStatus {
  pending
  accepted
  in_progress
  completed
  confirmed
  disputed
  cancelled
}

enum EscrowStatus {
  held
  released
  refunded
  split
}

enum DisputeOutcome {
  pending
  released_to_worker
  refunded_to_user
  split
}

enum RecipientType {
  user
  worker
}

enum SenderRole {
  user
  worker
}
