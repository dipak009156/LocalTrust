# ─── Existing LocalTrust vars ──────────────────────────────────────────────────
DATABASE_URL=your-database-url
JWT_SECRET=your-jwt-secret
CLOUDINARY_URL=your-cloudinary-url
FRONTEND_URL=http://localhost:5173

# ─── Sentinel Layer Integration ───────────────────────────────────────────────
# The /evaluate endpoint on the Sentinel engine
SENTINEL_API_URL=http://localhost:3001/evaluate

# Your tenant API key from POST /auth/register (shown once at registration)
SENTINEL_SECRET_KEY=paste-api-key-from-register-response-here

# The webhook secret YOU chose when calling PATCH /webhook
# Must match exactly what you sent to Sentinel
SENTINEL_WEBHOOK_SECRET=my-super-secret-webhook-key-123

# Shadow mode: set to "true" for the first 2 weeks to build behavioral baselines
# Sentinel collects data but never blocks anyone. Set to "false" to enforce.
SENTINEL_SHADOW_MODE=true
